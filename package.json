{
  "name": "dirabl-workspace",
  "private": true,
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p app && tsc --noEmit -p server && tsc -p tsconfig.tests.json",
    "lint": "eslint app server shared tests",
    "test": "vitest run",
    "check": "yarn typecheck && yarn lint && yarn test",
    "start": "yarn workspace dirabl start",
    "server": "yarn workspace dirabl-server dev",
    "format": "prettier --write app server shared tests *.json *.mjs README.md WORK_LOG.md docs/*.md"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "sql.js": "^1.15.1",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "vite": "8.3.5"
  },
  "type": "module",
  "packageManager": "yarn@1.22.22"
}
